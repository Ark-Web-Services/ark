# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — Godfather SEO Engine
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Cloudflare ────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your_cf_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id_here
D1_DATABASE_ID=your_d1_database_id_here

# ── AI APIs ───────────────────────────────────────────────────
REPLICATE_API_TOKEN=your_replicate_api_token_here
GEMINI_API_KEY=your_gemini_api_key_here
# Hosted credentials are for explicitly reviewed runs only.
CLAUDE_API_KEY=your_claude_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER_ORDER=ollama
LLM_PROVIDER_ORDER_LIGHT=ollama
LLM_PROVIDER_ORDER_HEAVY=ollama
# Subscription CLIs (not paid APIs, allowed unattended): add claude-cli and/or
# codex-cli to the order, e.g. LLM_PROVIDER_ORDER=ollama,claude-cli,codex-cli.
# They run `claude -p` / `codex exec` locally, or over SSH when a host is set.
# AGENT_CLI_HOST=user@latitude-host     # or CLAUDE_CLI_HOST / CODEX_CLI_HOST
# AGENT_CLI_SSH_KEY_FILE=~/.ssh/agent-cli
# CLAUDE_CLI_BIN=claude.cmd             # .cmd launchers on a Windows host
# CODEX_CLI_BIN=codex.cmd
# CLAUDE_CLI_MODEL=
# AGENT_CLI_TIMEOUT_MS=
# Paid providers are ignored until a reviewed run opts in with LLM_ALLOW_PAID=1.
# LLM_ALLOW_PAID=1
LLM_MODEL_LIGHT=anthropic/claude-4.5-haiku
LLM_MODEL_HEAVY=anthropic/claude-4.5-sonnet
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-5
GEMINI_MODEL=gemini-3.6-flash
IMAGE_MODEL=black-forest-labs/flux-dev
IMAGE_OUTPUT_QUALITY=88
LLM_MAX_CALLS_PER_RUN=12
LLM_LABEL_BATCH_SIZE=25
LLM_MAX_THREADS_TO_LABEL=75
LLM_MAX_RETRY_ATTEMPTS=8
LLM_MIN_INTERVAL_MS=10000
LLM_POLL_TIMEOUT_MS=600000
REPLICATE_ESTIMATED_USD_PER_PREDICT_SECOND=0.0014

# ── Google Search Console ─────────────────────────────────────
# Full JSON content of your service account key
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# Optional Search Console property override; defaults to sc-domain:<site domain>.
GSC_PROPERTY=sc-domain:example.com

# ── Community observation ─────────────────────────────────────
# Community observation is deterministic and makes no LLM calls.
# Create a script-type app at https://www.reddit.com/prefs/apps to obtain these credentials.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_SUBREDDITS=primary_topic,related_topic
REDDIT_MAX_THREADS_PER_SORT=100
REDDIT_LOOKBACK_HOURS=192
# Entries use Display Name|channel ID and are comma-separated.
YOUTUBE_CHANNELS=Example Channel|UC0000000000000000000000
# Entries use Display Name|RSS URL and are comma-separated.
COMMUNITY_FORUM_RSS_FEEDS=Example Forum|https://example.com/feed.xml
GOOGLE_AUTOCOMPLETE_SEEDS=primary topic,secondary topic
GOOGLE_AUTOCOMPLETE_CACHE_HOURS=72
COMMUNITY_USER_AGENT=GodfatherSEOEngine/1.0
OBSERVATION_USER_AGENT=GodfatherSEOEngineObserve/1.0
COMMUNITY_DOMAIN_STOPWORDS=example.com
COMMUNITY_PROBLEM_WORDS=help,problem,issue

# ── Visual Distribution ───────────────────────────────────────
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_APP_ID=your_pinterest_app_id_here
PINTEREST_APP_SECRET=your_pinterest_app_secret_here
PINTEREST_API_BASE=https://api.pinterest.com/v5
IMGUR_CLIENT_ID=your_imgur_client_id_here
IMGUR_ACCESS_TOKEN=your_imgur_access_token_here
TUMBLR_ACCESS_TOKEN=your_tumblr_access_token_here

# ── Site is configured in niche.config.ts ─────────────────────
# CI derives these from niche.config.ts. Set only for a local override.
# SITE_URL=https://example.com
# AUDIT_URL=https://example.com

# Bearer token for GET /api/work-queue (read-only actionable work list).
# Generate with: openssl rand -hex 32
WORK_QUEUE_TOKEN=

# ── Automation ────────────────────────────────────────────────
TZ=America/New_York
GIT_BOT_NAME=Godfather SEO Engine Bot
GIT_BOT_EMAIL=bot@example.com
SEO_AUDIT_USER_AGENT=GodfatherSEOEngineAudit/1.0
ESCALATION_CLI=claude
ESCALATION_LIMIT=10

# ── Local LLM (self-hosted Ollama) ───────────────────────────
# Unattended jobs use only Ollama and fail visibly when it is unavailable.
# Accepts the OpenAI-compatible base (…/v1) or the native root.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# Model tags are CASE-SENSITIVE: the q4_K_M suffix is capitalised.
OLLAMA_MODEL=qwen3.6:35b-a3b-q4_K_M
# Optional per-tier override; both default to OLLAMA_MODEL.
# OLLAMA_MODEL_HEAVY=
# OLLAMA_MODEL_LIGHT=
# Ollama auto-sizes context on recent builds. Pin it only if a long prompt is
# being silently truncated — too small a num_ctx drops tokens with no error.
# OLLAMA_NUM_CTX=32768
# The 10s inter-request floor exists for Replicate's rate limit; local calls
# are unmetered so they default to no delay.
# OLLAMA_MIN_INTERVAL_MS=0
# Per-tier paid order can be set for an explicitly reviewed run only.
# LLM_PROVIDER_ORDER_LIGHT=ollama
# LLM_PROVIDER_ORDER_HEAVY=replicate,ollama
# Reasoning costs output budget and is off by default. Worth trying on heavy.
# OLLAMA_THINK=false
# OLLAMA_THINK_LIGHT=false
# OLLAMA_THINK_HEAVY=true

# Service-business inquiries (server secrets; never put these in business.config.ts)
# Apply db/migrations/0001_leads.sql to a dedicated D1 binding named DB.
TURNSTILE_SECRET_KEY=
ADMIN_API_TOKEN=
EMAIL_API_KEY=
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
LEAD_RATE_LIMIT_SALT=
# Optional signed CRM webhook; configure only an endpoint you control.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Local testing only; never enable on a production deployment.
# LEADS_ALLOW_UNVERIFIED_LOCAL=true
