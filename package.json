{
  "name": "godfather-seo-engine",
  "type": "module",
  "version": "4.0.0",
  "description": "Godfather SEO Engine \u2014 Multi-niche authority site framework with AI agent pipeline. Astro 5 + Cloudflare D1 + Drone CI. Lighthouse-perfect edition.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "init-niche": "node --import tsx scripts/init-niche.ts",
    "init-niche:dry": "node --import tsx scripts/init-niche.ts --dry-run",
    "db:migrate": "npx wrangler d1 execute seo-authority-db --local --file=./db/schema.sql",
    "db:seed": "npx wrangler d1 execute seo-authority-db --local --file=./db/seed.sql",
    "db:migrate:prod": "npx wrangler d1 execute seo-authority-db --file=./db/schema.sql",
    "db:seed:prod": "npx wrangler d1 execute seo-authority-db --file=./db/seed.sql",
    "link-audit": "node --import tsx scripts/internal-link-audit.ts",
    "deploy": "npm run build && wrangler pages deploy dist/",
    "orchestrate": "node --import tsx agents/orchestrator.ts",
    "gsc": "node --import tsx scripts/gsc-intel.ts",
    "gsc:inspect": "node --import tsx scripts/gsc-url-inspection.ts",
    "intelligence": "node --import tsx scripts/native_intel.ts",
    "gsc:questions": "node --import tsx scripts/gsc_questions.ts",
    "strategist": "node --import tsx scripts/paa_strategist.ts",
    "auto": "node --import tsx scripts/auto_pipeline.ts",
    "generate-rss": "node --import tsx scripts/generate_rss.ts",
    "gsc:sync": "node --import tsx scripts/gsc-sitemap-sync.ts",
    "heist": "node --import tsx scripts/sitemap-heist.ts",
    "content-map": "node --import tsx scripts/content-map.ts",
    "d1:sync": "node --import tsx scripts/d1-sync.ts",
    "strategy": "node --import tsx agents/strategy.ts",
    "write": "node --import tsx agents/writer.ts",
    "outreach": "node --import tsx agents/outreach.ts",
    "social": "node --import tsx agents/social-auditor.ts",
    "distribute": "node --import tsx agents/distributor.ts",
    "distribute:dry": "node --import tsx agents/distributor.ts --dry-run",
    "distribute:plan": "node --import tsx agents/distributor.ts",
    "audit": "node --import tsx scripts/audit.ts",
    "lighthouse": "node --import tsx scripts/lighthouse-ci.ts",
    "optimize-images": "node --import tsx scripts/optimize-images.ts",
    "observe": "node --import tsx scripts/run-schedule.ts observe",
    "analyze": "node --import tsx scripts/run-schedule.ts analyze",
    "write:weekly": "node --import tsx scripts/run-schedule.ts write-weekly",
    "lead:write": "node --import tsx scripts/write-lead-page.ts",
    "content:preflight": "node --import tsx scripts/content-preflight.ts",
    "editorial:trend": "node --import tsx scripts/prepare-editorial-trend.ts",
    "content:promotion": "node --import tsx scripts/publish-generated-content.ts",
    "audit:seo": "node --import tsx scripts/run-schedule.ts audit-seo",
    "backlinks": "node --import tsx scripts/run-schedule.ts backlinks",
    "weekly:all": "node --import tsx scripts/run-schedule.ts weekly-all",
    "schedule": "node --import tsx scripts/run-schedule.ts",
    "godfather": "npm run orchestrate && npm run gsc && npm run heist && npm run d1:sync && npm run strategy && npm run write && npm run build && npm run audit",
    "godfather:intel": "npm run gsc && npm run heist && npm run d1:sync && npm run strategy",
    "godfather:content": "npm run strategy && npm run write",
    "godfather:monthly": "npm run heist && npm run outreach && npm run social",
    "godfather:visual": "npm run distribute",
    "postdeploy": "npm run gsc:sync",
    "postbuild": "node --import tsx scripts/gate-admin-dashboard.ts && node --import tsx scripts/gate-business-build.ts",
    "work-queue": "node --import tsx scripts/build-work-queue.ts",
    "prebuild": "npm run work-queue",
    "overnight": "node --import tsx scripts/overnight.ts",
    "escalate": "node --import tsx scripts/escalate.ts",
    "template:service": "node --import tsx scripts/create-service-template.ts",
    "engine:sync": "node --import tsx scripts/sync-engine.ts",
    "check": "astro sync && tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:launch": "node --import tsx scripts/check-launch.ts",
    "client:presence": "node --import tsx scripts/client-presence.ts",
    "leads": "node --import tsx scripts/leads.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "@ulixee/cloud": "^2.0.0-alpha.34",
    "@ulixee/hero": "^2.0.0-alpha.34",
    "astro": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@cloudflare/workers-types": "^4.20240925.0",
    "@tailwindcss/vite": "^4.0.0",
    "@polkadot-api/substrate-client": "0.1.4",
    "@types/sharp": "^0.32.0",
    "lighthouse": "^12.0.0",
    "pa11y": "^8.0.0",
    "sharp": "^0.34.5",
    "smoldot": "2.0.26",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.80.0",
    "ws": "8.21.0"
  },
  "overrides": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
