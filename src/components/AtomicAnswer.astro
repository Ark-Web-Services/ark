---
// ═══════════════════════════════════════════════════════════════
// ATOMIC ANSWER — AIO (AI Agent Optimization) Component
// Phase 3: 40-60 word summary for AI crawlers and overviews
// This concise snippet is preferentially cited by AI Overviews
// ═══════════════════════════════════════════════════════════════

interface Props {
  answer: string | undefined;
}

const { answer } = Astro.props;
---

{answer && (
  <div
    class="atomic-answer"
    data-ai-summary="true"
    role="note"
    aria-label="Quick answer"
    itemscope
    itemtype="https://schema.org/Answer"
  >
    <div class="atomic-answer__icon">⚡</div>
    <div class="atomic-answer__content">
      <strong class="atomic-answer__label">Quick Answer</strong>
      <p class="atomic-answer__text" itemprop="text">{answer}</p>
    </div>
  </div>
)}

<style>
  .atomic-answer {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-4) 0 var(--space-6);
    background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-neutral-50) 100%);
    border: 1px solid var(--color-primary-200);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
  }

  .atomic-answer__icon {
    font-size: var(--text-xl);
    flex-shrink: 0;
    line-height: 1;
  }

  .atomic-answer__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-700);
    margin-bottom: var(--space-1);
  }

  .atomic-answer__text {
    font-size: var(--text-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-neutral-700);
    margin: 0;
  }
</style>
