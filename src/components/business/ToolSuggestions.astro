---
import Arrow from './Arrow.astro';
import InquiryForm from './InquiryForm.astro';
import SectionHeading from './SectionHeading.astro';
import { businessTools } from '../../lib/business-tools';
const { context = '', number } = Astro.props;
const isArticle = Astro.url.pathname.startsWith('/posts/');
const signals: Record<string, RegExp> = {
  'wordpress-repair-helper': /wordpress|repair|broken|error|hack|recovery/i,
  'repair-or-redesign': /redesign|rebuild|planning|plan/i,
  'redirect-map-planner': /redirect|migrat|launch/i,
  'backup-readiness-checker': /backup|restore|recovery/i,
  'service-page-planner': /seo|service|local|content/i,
  'custom-feature-brief': /custom|integrat|feature|booking/i,
  'starter-site-fit-checker': /scope|starter|small|budget|qualif/i,
  'white-label-website-brief': /handoff|brief|checklist|approval/i,
  'hosting-resale-worksheet': /hosting|resale|margin|economics/i,
  'revision-scope-checker': /revision|scope creep|change/i,
  'small-lead-opportunity-calculator': /lead|minimum|budget|economics/i,
  'outsource-or-hire': /hire|outsourc|capacity|overflow/i,
};
const ranked = businessTools.map(tool => ({ tool, score: (tool.related.some(link => link.url === Astro.url.pathname) ? 3 : 0) + (signals[tool.id]?.test(context) ? 2 : 0) })).filter(item => item.score > 0).sort((a, b) => b.score - a.score);
const suggestions = (ranked.length ? ranked.map(item => item.tool) : businessTools).slice(0, 2);
---
{suggestions.length > 0 && <aside class:list={["business-band tool-suggestions", !number && "business-band--gray"]} aria-labelledby="tool-suggestions-title">
  <div class="business-shell">
    {number ? <SectionHeading id="tool-suggestions-title" number={number} title="Related planning tools" /> : <h2 id="tool-suggestions-title">Related planning tools</h2>}
    <p>Get a checklist, worksheet, or project brief you can keep. No signup needed.</p>
    <ul class="business-tool-list" role="list">
      {suggestions.map(tool => <li><a class="business-row-link" href={`/tools/${tool.id}/`}>{tool.title}<Arrow /></a><p>{tool.description}</p></li>)}
    </ul>
    <a class="business-text-link" href="/tools/">Explore all free tools <Arrow /></a>
  </div>
</aside>}
{isArticle && <InquiryForm />}
