---
import type { BusinessTool } from '../../lib/tool-contract';
interface Props { tool: BusinessTool; consentKey: string; }
const { tool, consentKey } = Astro.props;
---
<div class="tool-workspace" data-tool-root data-tool-id={tool.id} data-consent-key={consentKey}>
  <form class="tool-form" data-tool-form autocomplete="off">
    <h2>Your details</h2>
    <p class="tool-privacy">This tool does not send your answers to our servers. They stay on this page unless you choose to copy, download, print, or send them. Exports include your entered details.</p>
    <div class="tool-fields">
      {tool.fields.map(field => <div class:list={['tool-field', { 'tool-field--wide': field.type === 'textarea' }]}>
        <label for={`field-${field.id}`}>{field.label}{!field.required && <span> (optional)</span>}</label>
        {field.hint && <p class="tool-hint" id={`hint-${field.id}`}>{field.hint}</p>}
        {field.type === 'select' ? <select id={`field-${field.id}`} name={field.id} required={field.required} aria-describedby={field.hint ? `hint-${field.id}` : undefined}>
          <option value="" selected={!field.defaultValue}>{field.required ? 'Choose an answer' : 'Not specified'}</option>
          {field.options?.map(option => <option value={option.value} selected={field.defaultValue === option.value}>{option.label}</option>)}
        </select> : field.type === 'textarea' ? <textarea id={`field-${field.id}`} name={field.id} required={field.required} rows="4" maxlength={field.maxLength ?? 16000} placeholder={field.placeholder} aria-describedby={field.hint ? `hint-${field.id}` : undefined}>{field.defaultValue ?? ''}</textarea> : <input id={`field-${field.id}`} name={field.id} type={field.type} required={field.required} min={field.min} max={field.max} step={field.type === 'number' ? (field.step ?? 'any') : undefined} maxlength={field.type !== 'number' ? (field.maxLength ?? 1000) : undefined} value={field.defaultValue} placeholder={field.placeholder} aria-describedby={field.hint ? `hint-${field.id}` : undefined} />}
      </div>)}
    </div>
    <p class="tool-error" data-tool-error role="alert" tabindex="-1" hidden></p>
    <div class="tool-actions"><button class="tool-primary" type="submit">{tool.submitLabel}</button><button class="tool-secondary" type="reset">Clear answers</button></div>
    <noscript><p>Enable JavaScript to use this tool. The method and guidance below remain available, and you can contact us directly.</p></noscript>
  </form>
  <aside class="tool-result" aria-label="Tool result">
    <div data-tool-empty><h2>A useful next step.</h2><p>Complete the questions, then select “{tool.submitLabel}” to see your result here.</p><p>No account or email address needed.</p></div>
    <section data-tool-output aria-label="Your result" hidden>
      <h2 data-result-title tabindex="-1"></h2>
      <p data-result-summary></p>
      <dl class="tool-metrics" data-result-metrics></dl>
      <div data-result-sections></div>
      <div class="tool-actions tool-result-actions"><button type="button" class="tool-secondary" data-tool-copy>Copy result</button><button type="button" class="tool-secondary" data-tool-download>Download text</button><button type="button" class="tool-secondary" data-tool-file hidden>Download CSV</button><button type="button" class="tool-secondary" data-tool-print>Print result</button></div>
      <p class="tool-status" data-tool-status role="status" aria-live="polite"></p>
      <label class="tool-copy-fallback" data-copy-fallback hidden>Copy your result from this box<textarea readonly rows="7" data-copy-text></textarea></label>
      <div class="tool-next-step"><h3>Want help with the next step?</h3><p>You can copy your result and include it when you contact us. Nothing is sent automatically.</p><a class="tool-primary" href={tool.ctaHref} data-tool-cta>{tool.ctaLabel}</a></div>
    </section>
  </aside>
</div>
<script>
  import { businessTools } from '../../lib/business-tools';
  import type { ToolInput, ToolResult } from '../../lib/tool-contract';
  document.querySelectorAll<HTMLElement>('[data-tool-root]').forEach(root => {
    const tool = businessTools.find(item => item.id === root.dataset.toolId);
    if (!tool) return;
    const find = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const form = find<HTMLFormElement>('[data-tool-form]');
    const error = find<HTMLParagraphElement>('[data-tool-error]');
    const output = find<HTMLElement>('[data-tool-output]');
    const empty = find<HTMLElement>('[data-tool-empty]');
    const status = find<HTMLElement>('[data-tool-status]');
    const fileButton = find<HTMLButtonElement>('[data-tool-file]');
    let result: ToolResult | undefined;
    let resultText = '';
    let started = false;
    const track = (name: string) => {
      try {
        const consent = localStorage.getItem(root.dataset.consentKey || '');
        const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
        if (consent === 'granted' && typeof gtag === 'function') gtag('event', name, { tool_id: tool.id });
      } catch { /* A result never depends on analytics or storage. */ }
    };
    const clearOutput = () => {
      result = undefined; resultText = ''; output.hidden = true; empty.hidden = false;
      error.hidden = true; status.textContent = '';
      find<HTMLElement>('[data-copy-fallback]').hidden = true;
      find<HTMLTextAreaElement>('[data-copy-text]').value = '';
      find<HTMLElement>('[data-result-sections]').replaceChildren();
      find<HTMLElement>('[data-result-metrics]').replaceChildren();
    };
    form.addEventListener('input', () => { clearOutput(); if (!started) { track('tool_start'); started = true; } });
    form.addEventListener('change', clearOutput);
    form.addEventListener('reset', () => { clearOutput(); started = false; });
    const textElement = (tag: string, text: string) => {
      const element = document.createElement(tag); element.textContent = text; return element;
    };
    form.addEventListener('submit', event => {
      event.preventDefault(); clearOutput();
      const input: ToolInput = {};
      const data = new FormData(form);
      for (const field of tool.fields) input[field.id] = String(data.get(field.id) ?? '').trim();
      try {
        result = tool.calculate(input);
        if (result.error) throw new Error(result.summary);
        find<HTMLElement>('[data-result-title]').textContent = result.title;
        find<HTMLElement>('[data-result-summary]').textContent = result.summary;
        const metrics = find<HTMLElement>('[data-result-metrics]');
        for (const metric of result.metrics ?? []) {
          const row = document.createElement('div');
          const value = textElement('dd', metric.value);
          if (metric.detail) value.append(textElement('small', metric.detail));
          row.append(textElement('dt', metric.label), value);
          metrics.append(row);
        }
        const sections = find<HTMLElement>('[data-result-sections]');
        for (const section of result.sections) {
          const block = document.createElement('section'); block.append(textElement('h3', section.title));
          const list = document.createElement('ul');
          for (const item of section.items) list.append(textElement('li', item));
          block.append(list); sections.append(block);
        }
        resultText = [tool.title, '', result.title, result.summary, '', ...(result.metrics ?? []).map(m => `${m.label}: ${m.value}${m.detail ? ` (${m.detail})` : ''}`), ...result.sections.flatMap(s => ['', s.title, ...s.items.map(item => `- ${item}`)]), '', 'Your entered details', ...tool.fields.map(f => {
          const value = input[f.id];
          const label = f.options?.find(option => option.value === value)?.label ?? value;
          return `${f.label}: ${label || 'Not specified'}`;
        }), '', 'Use this as a planning aid based on your entered answers. Confirm assumptions before acting.'].join('\n');
        fileButton.hidden = !result.download;
        fileButton.textContent = result.download?.filename.endsWith('.csv') ? 'Download CSV' : 'Download worksheet';
        output.hidden = false; empty.hidden = true;
        if (!started) { track('tool_start'); started = true; }
        track('tool_complete');
        find<HTMLElement>('[data-result-title]').focus();
      } catch (failure) {
        error.textContent = failure instanceof Error ? failure.message : 'Check your answers and try again.';
        error.hidden = false; error.focus();
      }
    });
    find<HTMLButtonElement>('[data-tool-copy]').addEventListener('click', async () => {
      if (!result) return;
      try { await navigator.clipboard.writeText(resultText); status.textContent = 'Copied. You can paste the result into your own document or inquiry.'; track('tool_export'); }
      catch {
        find<HTMLElement>('[data-copy-fallback]').hidden = false;
        const area = find<HTMLTextAreaElement>('[data-copy-text]'); area.value = resultText; area.focus(); area.select();
        status.textContent = 'Automatic copying is unavailable. Copy the selected text below, or use Download text.';
      }
    });
    const download = (filename: string, content: string, mime: string) => {
      try {
        const url = URL.createObjectURL(new Blob([content], { type: mime }));
        const link = document.createElement('a'); link.href = url; link.download = filename;
        document.body.append(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
        status.textContent = 'Download requested. Check your browser downloads.'; track('tool_export');
      } catch { status.textContent = 'The download could not start. Use Copy result or Print result instead.'; }
    };
    find<HTMLButtonElement>('[data-tool-download]').addEventListener('click', () => { if (result) download(`${tool.id}.txt`, resultText, 'text/plain;charset=utf-8'); });
    fileButton.addEventListener('click', () => { if (result?.download) download(result.download.filename, result.download.content, result.download.mime); });
    find<HTMLButtonElement>('[data-tool-print]').addEventListener('click', () => { if (result) { window.print(); track('tool_export'); } });
    find<HTMLAnchorElement>('[data-tool-cta]').addEventListener('click', () => track('tool_cta_click'));
  });
</script>
