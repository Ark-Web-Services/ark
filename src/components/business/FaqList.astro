---
import type { BusinessConfig } from "../../../business.config";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  faqs?: BusinessConfig["faqs"];
  title?: string;
  number?: string;
}

const { faqs = [], title = "Frequently asked questions", number = "04" } = Astro.props;
---
{faqs.length > 0 && (
  <section class="business-band" aria-labelledby="faq-title">
    <div class="business-shell">
      <SectionHeading id="faq-title" number={number} title={title} />
      <div class="business-faq">
        {faqs.map((faq) => (
          <details>
            <summary>
              {faq.question}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                <path class="business-faq__plus" d="M12 5v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
