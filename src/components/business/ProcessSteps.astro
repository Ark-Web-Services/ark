---
const { steps = [] } = Astro.props;
---
{steps.length > 0 && <section class="business-section" aria-labelledby="process-title">
  <h2 id="process-title">A clear path from first review to launch</h2>
  <ol class="business-process-list">{steps.map((step) => <li><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
</section>}
