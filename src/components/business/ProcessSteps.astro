---
import type { BusinessConfig } from "../../../business.config";

interface Props {
  steps?: BusinessConfig["process"];
}

const { steps = [] } = Astro.props;
---
{steps.length > 0 && (
  <ol class="business-process-list" role="list">
    {steps.map((step, index) => (
      <li>
        <span class="business-process-list__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      </li>
    ))}
  </ol>
)}
