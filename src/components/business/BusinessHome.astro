---
import businessConfig from "../../../business.config";
import { businessTools } from "../../lib/business-tools";
import Arrow from "./Arrow.astro";
import FaqList from "./FaqList.astro";
import InquiryForm from "./InquiryForm.astro";
import ProcessSteps from "./ProcessSteps.astro";
import SectionHeading from "./SectionHeading.astro";
import ServiceList from "./ServiceList.astro";
import Testimonials from "./Testimonials.astro";

const { config = businessConfig, preview = false } = Astro.props;
const reviewHref = `mailto:${config.email}?subject=${encodeURIComponent("Free website review")}&body=${encodeURIComponent("Website URL:\nWhat would you like to improve?\n")}`;
const featuredTools = [
  { id: "repair-or-redesign", description: "Make a first pass at what to keep, improve, or review." },
  { id: "wordpress-repair-helper", description: "Organize the symptoms and prepare a useful first-response checklist." },
  { id: "service-page-planner", description: "Turn your services and customer questions into a page outline." },
].flatMap(({ id, description }) => businessTools.filter((tool) => tool.id === id).map(({ title }) => ({ id, title, description })));
---
<section class="business-band business-hero" aria-labelledby="business-title">
  <div class="business-shell business-hero__grid">
    <div class="business-hero__intro">
      <h1 id="business-title">{config.hero.heading}</h1>
      <p class="business-lead">{config.hero.body}</p>
      <div class="business-hero__actions">
        <a class="business-button" href="/contact/">Get a free site review <Arrow /></a>
        <a class="business-text-link" href={reviewHref}>Or email a review request</a>
      </div>
      <p class="business-hero__scope">Written scope and project price before work begins.</p>
      {config.location && <p class="business-hero__location">{config.location} · Working nationwide</p>}
    </div>
    <nav class="business-symptoms" aria-labelledby="symptoms-title">
      <h2 id="symptoms-title">What's happening with your site?</h2>
      <ul role="list">
        {config.services.filter((service) => service.symptom).map((service) => (
          <li><a class="business-row-link" href={`/services/${service.id}/`}>{service.symptom}<Arrow /></a></li>
        ))}
      </ul>
      <a class="business-text-link" href="/tools/">Not sure? Try a free planning tool</a>
    </nav>
  </div>
</section>

<ServiceList services={config.services} home />

<section class="business-band" aria-labelledby="process-title">
  <div class="business-shell">
    <SectionHeading id="process-title" number="02" title="Process" />
    <ProcessSteps steps={config.process} />
    <div class="business-process-note">
      <p>Written scope and project price before work begins.</p>
      <a class="business-text-link" href="/process/">See how a project runs <Arrow /></a>
    </div>
  </div>
</section>

<section class="business-band business-band--gray" aria-labelledby="resources-title">
  <div class="business-shell business-split">
    <div>
      <SectionHeading id="resources-title" number="03" title="Planning tools" />
      <p class="business-lead">Use what you’ve noticed about your site to decide what to look at first.</p>
      <p class="business-tools-note">Based on the information you enter. These tools do not scan or diagnose your website.</p>
    </div>
    <div>
      <ul class="business-tool-list" role="list">
        {featuredTools.map((tool) => (
          <li>
            <a class="business-row-link" href={`/tools/${tool.id}/`}>{tool.title}<Arrow /></a>
            <p>{tool.description}</p>
          </li>
        ))}
      </ul>
      <a class="business-text-link" href="/tools/">Browse all six tools <Arrow /></a>
    </div>
  </div>
  <div class="business-shell business-resource-links">
    <p>Prefer to read first?</p>
    <a class="business-text-link" href="/articles/">Practical website guides</a>
    <a class="business-text-link" href="/solutions/">Find your starting point</a>
  </div>
</section>

<Testimonials testimonials={config.testimonials} preview={preview} />
<FaqList faqs={config.faqs} />
<InquiryForm config={config} reviewHref={reviewHref} />
