---
const { projects = [], preview = false } = Astro.props;
---
{(projects.length > 0 || preview) && <section class="business-section" id="portfolio" aria-labelledby="portfolio-title">
  <div class="business-section__heading"><h2 id="portfolio-title">Selected work</h2><a class="business-text-link" href="/portfolio/">View the portfolio</a></div>
  {projects.length > 0 ? <ul class="business-project-list">{projects.map((project) => <li>
    <figure><img src={project.image} alt={project.imageAlt} loading="lazy" /><figcaption><h3>{project.title}</h3><p>{project.description}</p>{project.credit && <small>{project.credit}</small>}</figcaption></figure>
  </li>)}</ul> : <p class="business-empty">Portfolio projects will appear here after real work and image permissions are added.</p>}
</section>}
