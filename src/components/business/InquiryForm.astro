---
import businessConfig from "../../../business.config";

const { config = businessConfig } = Astro.props;
const formReady = config.inquiries.enabled && Boolean(config.inquiries.turnstileSiteKey);
const fallbackMessage = [
  "Name:",
  "Email address:",
  "Business name:",
  "Current website:",
  "Service of interest:",
  "Budget range:",
  "Message:",
].join("\n");
const fallbackHref = `mailto:${config.email}?subject=${encodeURIComponent("Free website review")}&body=${encodeURIComponent(fallbackMessage)}`;
---
<section class="business-section business-inquiry" id="inquiry" aria-labelledby="inquiry-title">
  <div class="business-inquiry__intro">
    <h2 id="inquiry-title">Get a free site review.</h2>
    <p>Share the issue you want to solve and the work you have in mind.</p>
    {formReady && <p><a class="business-text-link" href={`mailto:${config.email}`}>Or email {config.email}</a></p>}
  </div>
  {formReady ? <form class="business-form" action={config.inquiries.endpoint} method="post" data-success-message={config.inquiries.successMessage}>
    <div class="business-form__grid">
      <label>Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
      <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
      <label>Phone <span>(optional)</span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
      <label>Event date <span>(optional)</span><input name="eventDate" type="date" data-event-date /></label>
      <label>Event location <span>(optional)</span><input name="location" autocomplete="address-level2" maxlength="160" /></label>
      <label>Guest count <span>(optional)</span><input name="guestCount" inputmode="numeric" maxlength="20" /></label>
      <label>Budget range <span>(optional)</span><input name="budget" maxlength="80" /></label>
      <label>What kind of gathering are you planning?
        <select name="service" required>
          <option value="">Choose a service</option>
          {config.services.map((service) => <option value={service.id}>{service.title}</option>)}
          <option value="other">Other / not listed</option>
        </select>
      </label>
      <label class="business-form__wide">Anything else we should know?<textarea name="message" rows="5" required maxlength="4000"></textarea></label>
    </div>
    <label class="business-consent"><input name="consent" type="checkbox" value="yes" required /> <span>I agree to be contacted about this inquiry and have read the <a href="/privacy/">privacy notice</a>.</span></label>
    <div class="business-trap" aria-hidden="true"><label>Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <input type="hidden" name="source" value="website-inquiry" />
    <input type="hidden" name="utmSource" />
    <input type="hidden" name="utmMedium" />
    <input type="hidden" name="utmCampaign" />
    <input type="hidden" name="idempotencyKey" />
    <div class="cf-turnstile" data-sitekey={config.inquiries.turnstileSiteKey} data-action="inquiry"></div>
    <p class="business-form__status" role="status" aria-live="polite"></p>
    <button class="business-button" type="submit">Send inquiry</button>
    <p class="business-form__note">Your details are used only to respond to this inquiry.</p>
  </form> : <div class="business-form-setup">
    <p><a class="business-button" href={fallbackHref}>Email ARK about your website</a></p>
    <p>Include the details you choose to share. We’ll reply by email.</p>
    {config.phone && <p>Or call <a href={`tel:${config.phone.replace(/[^+\d]/g, "")}`}>{config.phone}</a>.</p>}
  </div>}
</section>

{formReady && <script is:inline define:vars={{ endpoint: config.inquiries.endpoint }}>
  (() => {
    const form = document.querySelector(".business-form");
    if (!form) return;
    const status = form.querySelector(".business-form__status");
    const submit = form.querySelector('button[type="submit"]');
    const token = form.querySelector('[name="idempotencyKey"]');
    const setKey = () => {
      if (!token.value) token.value = globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    };
    setKey();
    const applyAttribution = () => {
      try {
        const saved = JSON.parse(sessionStorage.getItem("business-inquiry-attribution") || "{}");
        for (const field of ["utmSource", "utmMedium", "utmCampaign"]) form.elements[field].value = (saved[field] || "").slice(0, 120);
      } catch { /* Storage may be unavailable; submission remains usable. */ }
    };
    applyAttribution();
    const dateField = form.querySelector("[data-event-date]");
    if (dateField) dateField.min = new Date().toISOString().slice(0, 10);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const challenge = form.querySelector('[name="cf-turnstile-response"]');
      if (!challenge?.value) {
        status.textContent = "Please complete the verification check before sending.";
        return;
      }
      setKey();
      const payload = Object.fromEntries(new FormData(form).entries());
      payload.consent = form.elements.consent.checked;
      submit.disabled = true;
      submit.textContent = "Sending…";
      status.textContent = "Sending your inquiry…";
      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json", "idempotency-key": token.value },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          throw new Error(result.message || result.error || "We couldn’t send your inquiry. Your entries are still here; please try again or email us.");
        }
        status.textContent = form.dataset.successMessage || "Thank you. Your inquiry has been received.";
        if (typeof window.gtag === "function") window.gtag("event", "generate_lead", { method: "website_form" });
        form.reset();
        token.value = "";
        setKey();
        applyAttribution();
        try { window.turnstile?.reset(); } catch { /* Widget can be absent if its script was blocked. */ }
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "We couldn’t send your inquiry. Please try again or email us.";
        try { window.turnstile?.reset(); } catch { /* Preserve form values and allow another attempt. */ }
      } finally {
        submit.disabled = false;
        submit.textContent = "Send inquiry";
      }
    });
  })();
</script>}
{formReady && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
