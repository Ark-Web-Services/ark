---
interface Props {
  ga4Id?: string;
}

const { ga4Id = "" } = Astro.props;
const configuredGa4Id = /^G-[A-Z0-9]{6,}$/i.test(ga4Id) ? ga4Id : "";
---

<section
  class="analytics-preferences"
  id="analytics-preferences"
  aria-label="Privacy and analytics choices"
  hidden
>
  <div class="analytics-preferences__copy">
    <h2 tabindex="-1">Privacy &amp; cookies</h2>
    <p>
      Allow Google Analytics to measure visits using page paths and fixed contact-link labels.
      Names, email addresses, and message contents are never sent to analytics. You can change this choice from the footer.
    </p>
    <p><a href="/privacy/">Read the privacy notice.</a></p>
    <p class="analytics-preferences__status" data-analytics-status aria-live="polite"></p>
  </div>
  <div class="analytics-preferences__actions">
    <button type="button" data-analytics-allow>Allow analytics</button>
    <button type="button" data-analytics-decline>Decline analytics</button>
  </div>
</section>

<script is:inline define:vars={{ ga4Id: configuredGa4Id }}>
  (() => {
    const consentKey = "arkwebservices:analytics-consent:v1";
    const panel = document.getElementById("analytics-preferences");
    const status = panel?.querySelector("[data-analytics-status]");
    const allowButton = panel?.querySelector("[data-analytics-allow]");
    const declineButton = panel?.querySelector("[data-analytics-decline]");
    if (!panel || !status || !allowButton || !declineButton) return;

    let configured = false;
    let consent = "";

    const safePageUrl = (value) => {
      try {
        const url = new URL(value, window.location.origin);
        return `${url.origin}${url.pathname}`;
      } catch {
        return window.location.origin + window.location.pathname;
      }
    };

    const storedConsent = () => {
      try {
        const value = window.localStorage.getItem(consentKey);
        return value === "granted" || value === "denied" ? value : "";
      } catch {
        return "";
      }
    };

    const saveConsent = (value) => {
      consent = value;
      try {
        window.localStorage.setItem(consentKey, value);
      } catch {
        // Analytics remains disabled unless this choice can be stored locally.
        consent = "denied";
      }
      if (consent === "granted") enableAnalytics();
      else disableAnalytics();
      panel.hidden = true;
    };

    const enableAnalytics = () => {
      if (consent !== "granted" || !ga4Id) return;
      window[`ga-disable-${ga4Id}`] = false;
      if (configured) return;

      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
      window.gtag("config", ga4Id, {
        send_page_view: true,
        page_location: safePageUrl(window.location.href),
        page_referrer: document.referrer ? safePageUrl(document.referrer) : "",
      });

      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4Id)}`;
      script.referrerPolicy = "strict-origin-when-cross-origin";
      document.head.appendChild(script);
      configured = true;
    };

    const disableAnalytics = () => {
      if (ga4Id) window[`ga-disable-${ga4Id}`] = true;
    };

    const showPreferences = (focus = false) => {
      const current = consent || storedConsent();
      status.textContent = current === "granted"
        ? "Analytics are on. You can turn them off here."
        : current === "denied"
          ? "Analytics are off. You can allow them here."
          : "Analytics are off until you choose to allow them.";
      allowButton.textContent = current === "granted" ? "Keep analytics on" : "Allow analytics";
      declineButton.textContent = current === "denied" ? "Keep analytics off" : "Decline analytics";
      panel.hidden = false;
      if (focus) panel.querySelector("h2")?.focus();
    };

    allowButton.addEventListener("click", () => saveConsent("granted"));
    declineButton.addEventListener("click", () => saveConsent("denied"));
    window.addEventListener("hashchange", () => {
      if (window.location.hash === "#analytics-preferences") showPreferences(true);
    });
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('a[href="#analytics-preferences"]');
      if (!link) return;
      event.preventDefault();
      if (window.location.hash !== "#analytics-preferences") {
        window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}#analytics-preferences`);
      }
      showPreferences(true);
    });

    consent = storedConsent();
    if (consent === "granted") enableAnalytics();
    else if (consent === "denied") disableAnalytics();
    else showPreferences();

    if (window.location.hash === "#analytics-preferences") showPreferences(true);
  })();
</script>

<style>
  .analytics-preferences[hidden] { display: none; }
  .analytics-preferences {
    position: fixed;
    z-index: 10000;
    inset: auto 1rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: min(920px, calc(100% - 2rem));
    margin-inline: auto;
    padding: 1.1rem 1.25rem;
    color: #111;
    background: #fff;
    border: 1px solid #111;
    box-shadow: 0 14px 36px rgb(0 0 0 / 16%);
    font: 400 .9rem/1.45 "DM Sans", sans-serif;
  }
  .analytics-preferences__copy { max-width: 62ch; }
  .analytics-preferences h2 { margin: 0 0 .3rem; color: #111; font: 600 1rem/1.25 "Montserrat Alternates", sans-serif; letter-spacing: -.02em; }
  .analytics-preferences p { margin: 0; color: #555; }
  .analytics-preferences a { color: #111; text-underline-offset: .2em; }
  .analytics-preferences__status { margin-top: .3rem !important; color: #333 !important; font-size: .78rem; }
  .analytics-preferences__actions { display: flex; flex-shrink: 0; gap: .6rem; }
  .analytics-preferences button {
    min-height: 42px;
    padding: .55rem .8rem;
    color: #111;
    background: #fff;
    border: 1px solid #111;
    border-radius: 2px;
    cursor: pointer;
    font: 700 .78rem/1.2 "DM Sans", sans-serif;
  }
  .analytics-preferences button:first-child { color: #fff; background: #111; border-color: #111; }
  .analytics-preferences button:hover { filter: brightness(1.08); }
  .analytics-preferences button:focus-visible, .analytics-preferences h2:focus-visible { outline: 3px solid #555; outline-offset: 3px; }
  .analytics-preferences h2 { border-radius: 1px; }
  @media (max-width: 700px) {
    .analytics-preferences { align-items: stretch; flex-direction: column; gap: .85rem; padding: 1rem; }
    .analytics-preferences__actions { display: grid; grid-template-columns: 1fr 1fr; }
  }
</style>
