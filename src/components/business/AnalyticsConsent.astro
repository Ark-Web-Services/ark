---
interface Props {
  ga4Id?: string;
}

const { ga4Id = "" } = Astro.props;
const configuredGa4Id = /^G-[A-Z0-9]{6,}$/i.test(ga4Id) ? ga4Id : "";
---

<section
  class="analytics-preferences"
  id="analytics-preferences"
  aria-labelledby="analytics-preferences-title"
  aria-describedby="analytics-preferences-status"
  hidden
>
  <div class="analytics-preferences__copy">
    <div>
      <h2 id="analytics-preferences-title" tabindex="-1">Analytics</h2>
      <p id="analytics-preferences-status" data-analytics-status aria-live="polite">Off by default.</p>
    </div>
    <a href="/privacy/">Privacy policy</a>
  </div>
  <div class="analytics-preferences__actions">
    <button type="button" data-analytics-allow>Allow</button>
    <button type="button" data-analytics-decline>Decline</button>
  </div>
</section>

<script is:inline define:vars={{ ga4Id: configuredGa4Id }}>
  (() => {
    const consentKey = "arkwebservices:analytics-consent:v1";
    const settingsHash = "#analytics-preferences";
    const panel = document.getElementById("analytics-preferences");
    const status = panel?.querySelector("[data-analytics-status]");
    const allowButton = panel?.querySelector("[data-analytics-allow]");
    const declineButton = panel?.querySelector("[data-analytics-decline]");
    if (!panel || !status || !allowButton || !declineButton) return;

    let configured = false;
    let consent = "";
    let preferencesTrigger = null;
    const { history, location } = window;

    const safePageUrl = (value) => {
      try {
        const url = new URL(value, location.origin);
        return `${url.origin}${url.pathname}`;
      } catch {
        return location.origin + location.pathname;
      }
    };

    const storedConsent = () => {
      try {
        const value = window.localStorage.getItem(consentKey);
        return value === "granted" || value === "denied" ? value : "";
      } catch {
        return "";
      }
    };

    const saveConsent = (value) => {
      consent = value;
      try {
        window.localStorage.setItem(consentKey, value);
      } catch {
        // Analytics remains disabled unless this choice can be stored locally.
        consent = "denied";
      }
      if (consent === "granted") enableAnalytics();
      else disableAnalytics();
      panel.hidden = true;
      if (location.hash === settingsHash) history.replaceState(history.state, "", location.pathname + location.search);
      preferencesTrigger?.focus();
      preferencesTrigger = null;
    };

    const enableAnalytics = () => {
      if (consent !== "granted" || !ga4Id) return;
      window[`ga-disable-${ga4Id}`] = false;
      if (configured) return;

      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
      window.gtag("config", ga4Id, {
        send_page_view: true,
        page_location: safePageUrl(location.href),
        page_referrer: document.referrer ? safePageUrl(document.referrer) : "",
      });

      const script = document.createElement("script");
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4Id)}`;
      script.referrerPolicy = "strict-origin-when-cross-origin";
      document.head.appendChild(script);
      configured = true;
    };

    const disableAnalytics = () => {
      if (ga4Id) window[`ga-disable-${ga4Id}`] = true;
    };

    const showPreferences = (focus = false) => {
      const current = consent || storedConsent();
      status.textContent = current === "granted" ? "Tracking is on."
        : current === "denied" ? "Tracking is off." : "Off by default.";
      panel.hidden = false;
      if (focus) panel.querySelector("h2")?.focus({ preventScroll: true });
    };

    panel.closest(".business-site")?.addEventListener("focusin", ({ target }) => {
      if (panel.hidden || !(target instanceof HTMLElement) || panel.contains(target)) return;
      const control = target.getBoundingClientRect();
      const notice = panel.getBoundingClientRect();
      if (control.bottom <= notice.top || control.top >= notice.bottom ||
          control.right <= notice.left || control.left >= notice.right) return;
      window.scrollBy({ top: control.bottom - notice.top + 8, behavior: "instant" });
    });

    allowButton.addEventListener("click", () => saveConsent("granted"));
    declineButton.addEventListener("click", () => saveConsent("denied"));
    window.addEventListener("hashchange", () => {
      if (location.hash === settingsHash) showPreferences(true);
    });
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest(`a[href="${settingsHash}"]`);
      if (!link) return;
      event.preventDefault();
      preferencesTrigger = link;
      if (location.hash !== settingsHash) history.replaceState(null, "", location.pathname + location.search + settingsHash);
      showPreferences(true);
    });

    consent = storedConsent();
    if (consent === "granted") enableAnalytics();
    else if (consent === "denied") disableAnalytics();
    else showPreferences();

    if (location.hash === settingsHash) showPreferences(true);
  })();
</script>

<style>
  .analytics-preferences[hidden] { display: none; }

  .analytics-preferences {
    --analytics-radius: var(--business-radius, 4px);
    position: fixed;
    z-index: 6;
    inset: auto 16px max(8px, env(safe-area-inset-bottom));
    width: min(43rem, calc(100% - 32px));
    max-height: calc(100dvh - 16px);
    margin-inline: auto;
    padding: 8px 16px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 24px;
    overflow: auto;
    color: var(--business-ink, #0d1117);
    background: var(--business-white, #ffffff);
    border: 1px solid var(--business-control, #677382);
    border-radius: var(--analytics-radius);
    font-family: var(--business-body, var(--font-family-sans, sans-serif));
    font-size: var(--business-type-small, 1rem);
    line-height: 1.25;
  }

  .analytics-preferences__copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 16px;
  }

  .analytics-preferences h2 {
    margin: 0;
    color: inherit;
    font-size: inherit;
    font-weight: 700;
    line-height: 1.25;
  }

  .analytics-preferences p {
    margin: 0;
    color: var(--business-muted, #47515e);
  }

  .analytics-preferences__copy a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    font-size: var(--business-type-label, .875rem);
  }

  .analytics-preferences__copy a:is(:hover, :active) {
    color: inherit;
    text-decoration-thickness: 2px;
  }

  .analytics-preferences__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .analytics-preferences button {
    min-height: 44px;
    padding: 8px 16px;
    color: var(--business-ink, #0d1117);
    background: var(--business-white, #ffffff);
    border: 1px solid var(--business-control, #677382);
    border-radius: var(--analytics-radius);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    transition: background-color 150ms ease;
  }

  .analytics-preferences :is(a, button, h2):focus-visible {
    outline: 3px solid var(--business-accent, #ff5a1f);
    outline-offset: 3px;
  }

  .analytics-preferences button:hover { background: var(--business-gray, #eef0f3); }
  .analytics-preferences button:active { background: var(--business-rule, #b9c1cb); }

  @media (max-width: 40rem) {
    .analytics-preferences {
      inset: auto 0 0;
      width: 100%;
      max-height: 40dvh;
      padding: 8px 16px max(8px, env(safe-area-inset-bottom));
      border-radius: 0;
    }
  }

  @media (max-width: 24rem) {
    .analytics-preferences { grid-template-columns: 1fr; }
  }
</style>
