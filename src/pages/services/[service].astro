---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Arrow from "@components/business/Arrow.astro";
import SectionHeading from "@components/business/SectionHeading.astro";
import ToolSuggestions from "@components/business/ToolSuggestions.astro";
import BusinessLayout from "@layouts/BusinessLayout.astro";
import business from "../../../business.config";

export async function getStaticPaths() {
  if (!business.enabled) return [];
  return business.services.map((service) => ({ params: { service: service.id }, props: { service } }));
}

const { service } = Astro.props;
const businessRouting = business as typeof business & { landingPageOnly?: boolean; customHomeContactHref?: string };
const contactHref = business.customHome || businessRouting.landingPageOnly ? businessRouting.customHomeContactHref || "/#contact" : "/contact/";
---

<BusinessLayout title={service.title} description={service.description}>
  <article class="business-inner-page service-page">
    <Breadcrumbs crumbs={[{ name: "Services", url: "/services/" }, { name: service.title, url: Astro.url.pathname }]} />
    <header class="business-band business-page-heading">
      <div class="business-shell">
        <h1>{service.title}</h1>
        <p class="business-lead">{service.description}</p>
      </div>
    </header>

    {service.details?.length > 0 && <section class="business-band business-band--gray" aria-labelledby="service-scope">
      <div class="business-shell">
        <SectionHeading id="service-scope" number="01" title="Project scope" />
        <ol class="service-scope-list" role="list">
          {service.details.map((detail, index) => <li><span class="business-label" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><p>{detail}</p></li>)}
        </ol>
        <a class="business-button business-button--secondary service-scope-review" href={contactHref}>Get a free site review <Arrow /></a>
      </div>
    </section>}

    <ToolSuggestions context={service.title} number={service.details?.length ? "02" : "01"} />

    <section class="business-band business-band--ink business-inner-close" aria-labelledby="service-review">
      <div class="business-shell">
        <h2 id="service-review">Start with a site review</h2>
        <p class="business-lead">Send us your website address and tell us what you’d like us to look at.</p>
        <a class="business-button" href={contactHref}>Get a free site review <Arrow /></a>
        <div class="business-direct-contact">
          {business.email && <a href={`mailto:${business.email}?subject=${encodeURIComponent(service.title)}`}>{business.email}</a>}
          {business.phone && <a href={`tel:${business.phone.replace(/[^+\d]/g, "")}`}>{business.phone}</a>}
        </div>
      </div>
    </section>
  </article>
</BusinessLayout>
