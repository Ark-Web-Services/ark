---
import BusinessLayout from '../../layouts/BusinessLayout.astro';
import Tool from '../../components/business/BusinessTool.astro';
import { businessTools } from '../../lib/business-tools';
import business from '../../../business.config';
import '../../styles/tools.css';

export function getStaticPaths() {
  return [{ params: { slug: undefined }, props: { tool: undefined } }, ...businessTools.map(tool => ({ params: { slug: tool.id }, props: { tool } }))];
}
const { tool } = Astro.props;
const isOverflow = business.website.includes('overflowsites.com');
const title = tool?.title ?? (isOverflow ? 'Free tools for agency website projects' : 'Free website planning and WordPress tools');
const description = tool?.description ?? (isOverflow ? 'Check starter-site scope, prepare white-label briefs, and work through agency project numbers with free, no-signup tools.' : 'Plan WordPress repairs, website redesigns, redirects, backups, service pages, and custom features with free, no-signup tools.');
const consentKey = isOverflow ? 'overflow-sites:analytics-consent:v1' : 'arkwebservices:analytics-consent:v1';
---
<BusinessLayout title={title} description={description}>
  <div class="business-home tools-page">
    <nav class="tool-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{tool ? <a href="/tools/">Free tools</a> : <span aria-current="page">Free tools</span>}</nav>
    <header class="tool-page-heading"><h1>{title}</h1><p>{tool?.intro ?? (isOverflow ? 'Make the next agency project easier to scope, hand off, and price. Each tool gives you a practical result you can keep. No signup required.' : 'Work through a website problem or prepare a clearer project brief. Choose a tool, enter what you know, and keep the result. No signup required.')}</p></header>
    {tool ? <>
      <Tool tool={tool} consentKey={consentKey} />
      <div class="tool-reference">
        <section><h2>How it works</h2><ol>{tool.method.map(item => <li>{item}</li>)}</ol><h3>A worked example</h3><p>{tool.example}</p></section>
        <section><h2>What to keep in mind</h2><ul>{tool.limitations.map(item => <li>{item}</li>)}</ul>{tool.sources.length > 0 && <><h3>References</h3><ul>{tool.sources.map(source => <li><a href={source.url} rel="noopener noreferrer">{source.label}</a></li>)}</ul></>}</section>
      </div>
      <section class="tool-faq"><h2>Common questions</h2>{tool.faqs.map(faq => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</section>
      <nav class="tool-related" aria-label="Related guidance"><a href="/tools/">Explore all tools</a>{tool.related.map(link => <a href={link.url}>{link.label}</a>)}</nav>
    </> : <>
      <ul class="tool-directory">{businessTools.map(item => <li><h2><a href={`/tools/${item.id}/`}>{item.title}</a></h2><p>{item.description}</p><a class="tool-open" href={`/tools/${item.id}/`}>Open tool<span class="sr-only">: {item.title}</span></a></li>)}</ul>
      <section class="tool-hub-close"><h2>{isOverflow ? 'Have a project in mind?' : 'Ready to talk about your website?'}</h2><p>{isOverflow ? 'Keep your agency fee and client relationship. Discuss a scoped starter website and ask privately about partner hosting terms.' : 'Bring your questions or a result from one of these tools. We can review the next step with you.'}</p><a class="tool-primary" href={isOverflow ? '/#partner' : '/contact/'}>{isOverflow ? 'Discuss a partnership' : 'Get a free site review'}</a></section>
    </>}
  </div>
</BusinessLayout>
