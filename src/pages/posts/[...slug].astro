---
// ═══════════════════════════════════════════════════════════════
// DYNAMIC POST PAGES — [...slug].astro
// Renders all content collection posts with PostLayout
// ═══════════════════════════════════════════════════════════════

import { getCollection } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";

export async function getStaticPaths() {
  const { default: business } = await import("../../../business.config");
  if (business.enabled && !business.contentEnabled) return [];
  const posts = await getCollection("posts", ({ data }) => data.status === "published");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(mdx?|md)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<PostLayout post={post} content={post.body ?? ""} headings={headings}>
  <Content />
</PostLayout>
