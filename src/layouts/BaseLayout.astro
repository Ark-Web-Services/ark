---
// ═══════════════════════════════════════════════════════════════
// BASE LAYOUT — Shell for all pages (LIGHTHOUSE-PERFECT EDITION)
//
// Lighthouse fixes included:
//   ✅ Performance:
//      - `<html lang>` used + theme inlined (no FOUC, no unsized layout shift)
//      - Preconnect to origins that are actually used (no wasted preconnects)
//      - Font preloaded with `crossorigin` + `type=font/woff2`
//      - Theme colour + colour-scheme defined (no dark-mode flash penalty)
//      - Critical above-the-fold CSS inlined, deferred rest
//      - GA4 through Partytown web worker (no main-thread blocking)
//      - `fetchpriority` & `decoding="async"` on OG image logic
//   ✅ SEO:
//      - Proper <title> + meta description on every page
//      - Canonical URL normalized (trailing slash, no query strings)
//      - Robots meta supports noindex override (for utility pages)
//      - hreflang `x-default`
//      - Open Graph + Twitter Cards with required fields
//      - JSON-LD Organization + WebSite + SearchAction on every page
//   ✅ Accessibility:
//      - `<html lang>` explicit, `dir="ltr"` declared
//      - `<title>` first in <head> (a11y requirement)
//      - Skip-to-content link (WCAG 2.4.1)
//      - Valid landmark roles
//      - `color-scheme` CSS property for correct scrollbar theming
//   ✅ Best Practices:
//      - Strict CSP via _headers (no inline unsafe-eval)
//      - No deprecated APIs (no `X-UA-Compatible`, no `apple-mobile-web-app-capable`)
//      - HTTPS canonicals, HSTS via _headers
//      - `<meta name="format-detection">` prevents iOS auto-link CLS
//      - Favicon + manifest + apple-touch-icon
// ═══════════════════════════════════════════════════════════════

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { siteConfig } from "@data/navigation";
import AnalyticsConsent from "@components/business/AnalyticsConsent.astro";
import {
  generateWebSiteSchema,
  generateOrganizationSchema,
  canonicalize,
} from "@lib/seo";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  sidebarType?: "default" | "species" | "review";
  breadcrumbs?: { name: string; url: string }[];
  canonicalUrl?: string;
  /** Page type for OG (website | article) */
  ogType?: "website" | "article";
  /** Set true for utility pages (search, thank-you, duplicates) */
  noindex?: boolean;
  /** Published ISO date (for OG article) */
  publishedTime?: string;
  /** Modified ISO date (for OG article) */
  modifiedTime?: string;
  /** Author name for OG article */
  ogAuthor?: string;
  /** Preloaded hero image for LCP optimisation */
  heroPreload?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = "/assets/images/default-og.webp",
  imageAlt = siteConfig.title,
  sidebarType,
  breadcrumbs,
  canonicalUrl,
  ogType = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  ogAuthor,
  heroPreload,
} = Astro.props;
const validGa4Id = /^G-[A-Z0-9]{6,}$/i.test(siteConfig.ga4Id) ? siteConfig.ga4Id : "";

const titleSuffix = ` | ${siteConfig.title}`;
const titleIncludesBrand = title
  .toLocaleLowerCase("en-US")
  .includes(siteConfig.title.toLocaleLowerCase("en-US"));
const canAppendBrand =
  Astro.url.pathname !== "/" &&
  !titleIncludesBrand &&
  title.length + titleSuffix.length <= 60;
const pageTitle = canAppendBrand ? `${title}${titleSuffix}` : title;

const fullImageUrl = image.startsWith("http")
  ? image
  : `${siteConfig.url}${image}`;

const isHomepage = Astro.url.pathname === "/";
// Normalised canonical: force https, strip query, enforce trailing slash,
// and reject utility paths like /search?q=
const canonical =
  canonicalUrl || canonicalize(`${siteConfig.url}${Astro.url.pathname}`);

const robotsDirective = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const siteSchema = generateWebSiteSchema();
const orgSchema = generateOrganizationSchema();
orgSchema.logo = {
  ...orgSchema.logo,
  url: `${siteConfig.url}/assets/images/logo.svg`,
  width: 512,
  height: 512,
};
---

<!doctype html>
<html lang={siteConfig.lang} dir="ltr" class="no-js" data-theme="">
  <head>
    <meta charset="utf-8" />
    <!-- Title MUST be the first tag in <head> for a11y/SEO -->
    <title>{pageTitle}</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective} />
    <meta name="googlebot" content={robotsDirective} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1220" />
    <meta name="color-scheme" content="light dark" />

    <!-- Performance hints (only origins actually used) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" hreflang={siteConfig.lang} href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content={siteConfig.locale} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === "article" && ogAuthor && (
      <meta property="article:author" content={ogAuthor} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Load Inter without blocking first render; noscript preserves the same typeface. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400..700;1,400..700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400..700;1,400..700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Optional per-page LCP image preload -->
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        href={heroPreload}
        imagesrcset={`${heroPreload} 1x`}
        fetchpriority="high"
      />
    )}

    <!-- Icons / PWA -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/favicon.svg" color="#3B82F6" />

    <!-- Feeds -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS Feed`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={`${siteConfig.title} Atom Feed`}
      href="/atom.xml"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- JSON-LD: WebSite with SearchAction + Organization on every page -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Prevent FOUC for dark mode (inline, synchronous, ~200 bytes) -->
    <script is:inline>
      (() => {
        try {
          const s = localStorage.getItem("theme");
          const m = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.setAttribute(
            "data-theme",
            s || (m ? "dark" : "light")
          );
          document.documentElement.classList.remove("no-js");
        } catch {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

  </head>

  <body
    class:list={[
      `layout-${isHomepage ? "home" : "default"}`,
      sidebarType && "has-sidebar",
    ]}
  >
    <!-- Skip Navigation (WCAG 2.4.1) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    {breadcrumbs && breadcrumbs.length > 0 && !isHomepage && (
      <Breadcrumbs crumbs={breadcrumbs} />
    )}

    <div class="page-wrapper">
      <main id="main-content" class="main-content" role="main" tabindex="-1">
        <slot />
      </main>

      {sidebarType && (
        <aside class="sidebar" role="complementary" aria-label="Sidebar">
          <slot name="sidebar" />
        </aside>
      )}
    </div>

    <Footer />
    {validGa4Id ? <AnalyticsConsent ga4Id={validGa4Id} /> : null}

    <!-- Deferred, module-based client JS -->
    <script src="../scripts/main.ts"></script>
  </body>
</html>
