{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "chromeFlags": "--headless --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance":     ["error", { "minScore": 0.9  }],
        "categories:accessibility":   ["error", { "minScore": 0.95 }],
        "categories:best-practices":  ["error", { "minScore": 0.95 }],
        "categories:seo":             ["error", { "minScore": 0.95 }],

        "meta-description":           ["error", { "minScore": 1 }],
        "canonical":                  ["error", { "minScore": 1 }],
        "robots-txt":                 ["error", { "minScore": 1 }],
        "is-crawlable":               ["error", { "minScore": 1 }],
        "http-status-code":           ["error", { "minScore": 1 }],
        "hreflang":                   ["error", { "minScore": 1 }],
        "viewport":                   ["error", { "minScore": 1 }],
        "document-title":             ["error", { "minScore": 1 }],
        "html-has-lang":              ["error", { "minScore": 1 }],
        "html-lang-valid":            ["error", { "minScore": 1 }],
        "tap-targets":                ["error", { "minScore": 1 }],
        "structured-data":            "off",

        "color-contrast":             ["error", { "minScore": 1 }],
        "image-alt":                  ["error", { "minScore": 1 }],
        "link-name":                  ["error", { "minScore": 1 }],
        "button-name":                ["error", { "minScore": 1 }],
        "aria-required-attr":         ["error", { "minScore": 1 }],
        "aria-valid-attr":            ["error", { "minScore": 1 }],
        "aria-valid-attr-value":      ["error", { "minScore": 1 }],

        "uses-responsive-images":     ["warn",  { "minScore": 0.9 }],
        "modern-image-formats":       ["warn",  { "minScore": 1 }],
        "efficient-animated-content": "off",

        "csp-xss":                    ["warn",  { "minScore": 1 }],
        "errors-in-console":          ["error", { "minScore": 1 }],
        "no-vulnerable-libraries":    ["error", { "minScore": 1 }],
        "is-on-https":                ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
